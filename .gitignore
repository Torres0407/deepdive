# ==============================================================================
# The Deep Dive - Git Ignore Configuration
# Protects sensitive data, databases, build artifacts, and dependencies
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.secret

# SQLite Databases & Local Storage
data/
**/data/
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-journal
*.sql.gz

# Production Build Artifacts
dist/
**/dist/
build/
out/
.next/
.nuxt/

# Logs & Debug Output
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache & Temporary Directories
.cache/
.temp/
tmp/
.eslintcache
.stylelintcache
*.tsbuildinfo

# OS Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Settings
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Local Docker Overrides
docker-compose.override.yml
